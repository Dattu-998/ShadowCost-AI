# Copy to .env and fill in. Never commit .env.

# Used to draft agent specs (any OpenAI-compatible API works; Groq has a free tier).
GROQ_API_KEY=
# Optional overrides:
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- the hosted product: every integration is optional ---------------------------------------
# Supabase: Project settings > API keys. The secret key is server-only.
SUPABASE_URL=https://jyixkprzmihvuanprfdm.supabase.co
SUPABASE_SECRET_KEY=
# Where the web app and this API are reachable (redirects, email links, OAuth).
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
# Stripe (test mode): sk_test_... and the webhook's whsec_...; run scripts/stripe_setup.py once.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend, for notification and invitation emails.
RESEND_API_KEY=
EMAIL_FROM=ShadowCost <onboarding@resend.dev>
# Google OAuth client (Web application); redirect URI: <API_URL>/v1/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: encrypts Google refresh tokens and signs OAuth state.
TOKEN_ENCRYPTION_KEY=
# Shared with the GitHub Actions daily-sync workflow.
CRON_SECRET=
