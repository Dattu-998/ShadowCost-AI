{
  "workflow_id": "W3",
  "name": "Invoice payment reminders",
  "summary": "On scheduled days the agent scans the invoices sheet for overdue items and sends reminder emails. It updates the reminder count, last reminder date and status according to the reminder stage.",
  "series": "invoices",
  "trigger": {
    "kind": "schedule",
    "weekdays": [
      0,
      3
    ]
  },
  "rules": [
    {
      "name": "First reminder",
      "when": [
        {
          "column": "status",
          "op": "eq",
          "value": "sent"
        },
        {
          "column": "reminders_sent",
          "op": "eq",
          "value": "0"
        },
        {
          "column": "due_date",
          "op": "days_since_at_least",
          "value": 7
        },
        {
          "column": "issue_date",
          "op": "days_since_at_least",
          "value": 21
        }
      ],
      "set": {
        "last_reminder_date": "{{today}}",
        "reminders_sent": "{{row.reminders_sent + 1}}",
        "status": "overdue"
      },
      "email": {
        "to": "{{row.customer_email}}",
        "subject": "Invoice {{row.invoice_id}} - payment reminder",
        "body": "Hi {{row.customer}} team,\n\nOur records show invoice {{row.invoice_id}} ({{money(row.amount)}}, due {{format_date(row.due_date)}}) is still unpaid.\n\nCould you let us know when we can expect payment?\n\nKind regards,\nAccounts team\nFernhill Supplies"
      }
    },
    {
      "name": "Second reminder",
      "when": [
        {
          "column": "status",
          "op": "eq",
          "value": "overdue"
        },
        {
          "column": "reminders_sent",
          "op": "eq",
          "value": "1"
        },
        {
          "column": "last_reminder_date",
          "op": "days_since_at_least",
          "value": 7
        },
        {
          "column": "due_date",
          "op": "days_since_at_least",
          "value": 15
        }
      ],
      "set": {
        "last_reminder_date": "{{today}}",
        "reminders_sent": "{{row.reminders_sent + 1}}"
      },
      "email": {
        "to": "{{row.customer_email}}",
        "subject": "Second reminder: invoice {{row.invoice_id}}",
        "body": "Dear {{row.customer}},\n\nWe still haven't received payment for invoice {{row.invoice_id}} ({{money(row.amount)}}), due {{format_date(row.due_date)}}.\n\nPlease let us know if there is a problem with the invoice.\n\nThanks,\nAccounts\nFernhill Supplies"
      }
    }
  ],
  "source": {
    "generated_by": "openai/gpt-oss-120b",
